# ===== فراز چمن — تنظیمات هاست آپاچی (سی‌پنل و مشابه آن) =====
# این فایل باید کنار index.html در پوشه‌ی اصلی سایت (public_html) باشد.

# ---------- مسیریابی تک‌صفحه‌ای (SPA) ----------
# آدرس‌هایی مثل /products/sports-artificial-turf فایل واقعی روی سرور
# ندارند؛ بدون این قانون، باز کردن مستقیم یا رفرش صفحه خطای ۴۰۴ می‌دهد.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # فایل‌ها و پوشه‌های واقعی (عکس، فونت، js، css) دست‌نخورده سرو شوند
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # بقیه‌ی مسیرها به index.html بروند تا React خودش صفحه را نشان دهد
  RewriteRule ^ index.html [L]
</IfModule>

# ---------- فشرده‌سازی ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---------- کش مرورگر ----------
# فایل‌های assets نام یکتا (hash) دارند، پس می‌توانند مدت طولانی کش شوند.
# index.html نباید کش شود تا بعد از هر آپدیت، نسخه‌ی جدید دیده شود.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|jpg|jpeg|png|webp|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ---------- نوع صحیح فونت ----------
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
</IfModule>
